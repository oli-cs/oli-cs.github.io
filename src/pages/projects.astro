---
import Layout from '../layouts/Html_Layout.astro';
import Card from '../components/Card.astro';
import '../styles/site-style.css';
---

<Layout title="Projects">
	<main>
		<nav>
			<ul role="list" class="navbar">
				<a href="..">Home</a>
				<a>Projects</a>
				<a href="../about/index.html">About Me</a>
				<a href="../music/index.html">Music</a>
				<a href="../links/index.html">Links</a>
			</ul>
		</nav>

		<h1>My <span class="text-gradient">Projects</span></h1>

		<ul role="list" class="projects-card-grid">
			<Card
				href="../project_posts/cleared_for_landing/index.html"
				title="Cleared for Landing"
				body="Waiting for a plane? Why not try being an air traffic controller!"
			/>
			<Card
				href="../project_posts/hacksheffield10/index.html"
				title="Oliver Charles Hidden"
				body="Combining game dev with hardware? Count me in!"
			/>
			<Card
				href="../project_posts/remote_trebuchet/index.html"
				title="Remote Trebuchet"
				body="Ever wanted to control a trebuchet with an app?"
			/>
			<Card
				href="../project_posts/gregor/index.html"
				title="Gregor"
				body="What if we put a raspberry pi in a rubber duck?"
			/>
			<Card
				href="../project_posts/furtones/index.html"
