				href="../project_posts/terraspace/index.html"
				title="TerraSpace"
				body="A 3D terrain generation website"
			/>
			<Card
				href="../project_posts/website/index.html"
				title="This website"
				body="Learn more about how this website was built!"
			/>
			<Card
				href="../project_posts/hackathons_info_bot/index.html"
				title="Hackathons Info Bot"
				body="Learn more about how my hackathons discord bot was built!"
			/>
			<Card
				href="../project_posts/hacktheburgh_x/index.html"
				title="HouseLink"
				body="Learn more about my team's HackTheBurgh X project!"
			/>	
			<Card
				href="../project_posts/hackaway_v7/index.html"
				title="Mansion Escape"
				body="Learn more about my team's Hackaway v7 project!"
			/>	
			<Card
				href="../project_posts/hacknotts_84/index.html"
				title="Massive Machine Retro Revelry"
